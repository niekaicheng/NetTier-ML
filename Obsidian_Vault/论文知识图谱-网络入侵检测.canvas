		{"id":"paper2","type":"file","file":"A Deep Learning Approach to NIDS (Shone et al. 2017).md","x":400,"y":50,"width":400,"height":350},
		{"id":"text2","type":"text","text":"# 🚀 降维与工程突围\n为了应对海量且高维的网络特征，\n抛弃过时的浅层学习与笨重的纯深层网络。","x":100,"y":0,"width":250,"height":200},
		{"id":"ndae","type":"file","file":"非对称深度自编码器 (NDAE).md","x":100,"y":250,"width":250,"height":250},
